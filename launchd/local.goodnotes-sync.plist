<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.goodnotes-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__APP__/goodnotes-sync</string>
    <string>tick</string>
  </array>
  <!-- install.sh fills in: daytime slots (active_hours, every check_every_minutes; a slot missed while asleep
       runs once on wake) that export when due (after lectures, export_times) and pick up new files, plus
       WatchPaths on aula-sync's state.json, so new downloads are imported right after aula-sync syncs.
       Nothing runs at night. RunAtLoad covers login. -->
  <key>StartCalendarInterval</key>
  <array>
__CALENDAR__
  </array>
__WATCH__
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Nice</key>
  <integer>19</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/goodnotes-sync/launchd.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
